# BenzWell Environment Variables Configuration
# Production Domain: https://digital.benzwell.in

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://digital.benzwell.in

# Supabase Credentials
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-side ONLY, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed Administrator Email Allowlist (comma-separated)
ADMIN_EMAILS=admin@benzwell.in

# Basic Website Demo URL (Configurable)
NEXT_PUBLIC_BASIC_DEMO_URL=https://demo-basic.benzwell.in

# Business Contact Defaults
NEXT_PUBLIC_CONTACT_WHATSAPP=+919923407176
NEXT_PUBLIC_CONTACT_PHONE=+919923407176
NEXT_PUBLIC_CONTACT_EMAIL=info@benzwell.in

# Optional: Resend API Key for automatic new lead notification emails to admin
# If left blank, enquiries are securely saved to Supabase without sending emails.
RESEND_API_KEY=
RESEND_NOTIFICATION_EMAIL=info@benzwell.in
RESEND_FROM_EMAIL=BenzWell Leads <leads@benzwell.in>

# -----------------------------------------------------------------------------
# SUPABASE AUTH CONFIGURATION INSTRUCTIONS:
# In Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: https://digital.benzwell.in
# - Redirect URLs (add all of the following):
#   * https://digital.benzwell.in/admin/reset-password
#   * https://digital.benzwell.in/admin/auth/callback
#   * http://localhost:3000/admin/reset-password
#   * http://localhost:3000/admin/auth/callback
# -----------------------------------------------------------------------------
