# BenzWell Environment Variables Configuration
# Production Domain: https://digital.benzwell.in

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://digital.benzwell.in

# Supabase Credentials
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-side ONLY, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Basic Website Demo URL (Configurable)
NEXT_PUBLIC_BASIC_DEMO_URL=https://demo-basic.benzwell.in

# Business Contact Defaults
NEXT_PUBLIC_CONTACT_WHATSAPP=+919876543210
NEXT_PUBLIC_CONTACT_PHONE=+919876543210
NEXT_PUBLIC_CONTACT_EMAIL=contact@benzwell.in

# Optional: Resend API Key for automatic new lead notification emails to admin
# If left blank, enquiries are securely saved to Supabase without sending emails.
RESEND_API_KEY=
RESEND_NOTIFICATION_EMAIL=admin@benzwell.in
RESEND_FROM_EMAIL=BenzWell Leads <leads@benzwell.in>
